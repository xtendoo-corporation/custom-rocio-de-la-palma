<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_res_config_settings_rocio_hermanos" model="ir.ui.view">
        <field name="name">res.config.settings.view.rocio.hermanos</field>
        <field name="model">res.config.settings</field>
        <field name="arch" type="xml">
            <form string="Ajustes" groups="base.group_system"/>
        </field>
    </record>

    <record id="res_config_settings_rocio_hermanos_inherit" model="ir.ui.view">
        <field name="name">res.config.settings.rocio.hermanos.inherit</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@id='companies']" position="after">
                <div id="hermandad_settings">
                    <block title="Hermandad" name="hermandad_setting_container">
                        <setting id="hermandad_fee_product_setting" string="Producto de cuota de hermano">
                            <field name="brother_fee_product_id"/>
                        </setting>
                        <setting id="hermandad_fee_journal_setting" string="Diario de cuotas de hermano">
                            <field name="brother_fee_journal_id"/>
                        </setting>
                    </block>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
