<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Acceso a la lista de hermanos (vista tree heredada) -->
    <record id="action_res_partner_rocio_hermanos" model="ir.actions.act_window">
        <field name="name">Hermanos</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_res_partner_tree_rocio_hermanos"/>
        <field name="domain">[("is_brother","=",True)]</field>
        <field name="context">{'default_is_brother': True}</field>
    </record>

    <menuitem id="menu_rocio_hermanos_list" name="Hermanos" parent="menu_rocio_hermanos" action="action_res_partner_rocio_hermanos"/>

    <!-- Acceso al asistente -->
    <record id="action_rocio_hermano_invoice_wizard" model="ir.actions.act_window">
        <field name="name">Generar cuotas de hermanos</field>
        <field name="res_model">rocio.hermano.invoice.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="view_id" ref="view_rocio_hermano_invoice_wizard"/>
    </record>

    <menuitem id="menu_rocio_hermanos_generate" name="Generar cuotas" parent="menu_rocio_hermanos" action="action_rocio_hermano_invoice_wizard"/>

    <!-- Nueva acción servidor: devuelve dinámicamente un act_window filtrado por el diario configurado -->
    <record id="action_rocio_hermanos_invoices_server" model="ir.actions.server">
        <field name="name">Facturas de cuotas (filtradas por diario)</field>
        <field name="model_id" ref="account.model_account_move"/>
        <field name="state">code</field>
        <field name="code">action = model.action_invoices_filtered_by_config_journal()</field>
    </record>

    <!-- Menú para listar facturas creadas por este módulo -->
    <menuitem id="menu_rocio_hermanos_invoices" name="Facturas de cuotas" parent="menu_rocio_hermanos" action="action_rocio_hermanos_invoices_server"/>


    <record id="action_rocio_brother_leave_reason" model="ir.actions.act_window">
        <field name="name">Motivos de baja</field>
        <field name="res_model">res.partner.leave.reason</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_rocio_brother_leave_reason" name="Motivos de baja" parent="menu_rocio_config" action="action_rocio_brother_leave_reason" sequence="1"/>
</odoo>
