<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Menú principal de la hermandad -->
    <menuitem id="menu_rocio_root" name="Hermandad" sequence="90"/>

    <!-- Acceso a la lista de hermanos (vista tree heredada) -->
    <record id="action_res_partner_rocio_hermanos" model="ir.actions.act_window">
        <field name="name">Hermanos</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">tree,form</field>
        <field name="view_id" ref="view_res_partner_tree_rocio_hermanos"/>
        <field name="domain">[('is_brother','=',True)]</field>
        <field name="context">{'default_is_brother': True}</field>
    </record>

    <menuitem id="menu_rocio_hermanos" name="Cuotas de hermanos" parent="menu_rocio_root" sequence="1"/>
    <menuitem id="menu_rocio_hermanos_list" name="Hermanos" parent="menu_rocio_hermanos" action="action_res_partner_rocio_hermanos"/>

    <!-- Acceso al asistente -->
    <record id="action_rocio_hermano_invoice_wizard" model="ir.actions.act_window">
        <field name="name">Generar cuotas de hermanos</field>
        <field name="res_model">rocio.hermano.invoice.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="view_id" ref="view_rocio_hermano_invoice_wizard_form"/>
    </record>

    <menuitem id="menu_rocio_hermanos_generate" name="Generar cuotas" parent="menu_rocio_hermanos" action="action_rocio_hermano_invoice_wizard"/>

    <!-- Acción y menú para listar facturas creadas por este módulo -->
    <record id="action_rocio_hermanos_invoices" model="ir.actions.act_window">
        <field name="name">Facturas de cuotas</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[('invoice_origin','=','Cuota de hermano'),('move_type','in',['out_invoice','out_refund'])]</field>
    </record>
    <menuitem id="menu_rocio_hermanos_invoices" name="Facturas de cuotas" parent="menu_rocio_hermanos" action="action_rocio_hermanos_invoices"/>
</odoo>
