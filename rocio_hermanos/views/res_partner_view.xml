<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_res_partner_form_inherit_rocio_hermanos" model="ir.ui.view">
        <field name="name">res.partner.form.rocio.hermanos</field>
        <field name="model">res.partner</field>
        <!-- Heredamos la vista oficial de contactos -->
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <!-- Ocultamos campos innecesarios: sitio web, título y etiquetas -->
            <xpath expr="//field[@name='website']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <xpath expr="//field[@name='title']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <xpath expr="//field[@name='category_id']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <!-- Movemos el campo ref a la sección de hermandad -->
            <xpath expr="//field[@name='ref']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <!-- Ribbon visual para Hermanos al principio del sheet para posicionamiento correcto -->
            <xpath expr="//sheet/*[1]" position="before">
                <widget name="web_ribbon" title="Hermano" bg_color="text-bg-info" invisible="not is_brother"/>
            </xpath>

            <xpath expr="//field[@name='name']/.." position="after">
                <div class="o_row" name="is_brother_row">
                    <field name="is_brother" widget="boolean_toggle" groups="base.group_user"/>
                    <label for="is_brother" groups="base.group_user" string="Es Hermano"/>
                </div>
            </xpath>

            <!-- Insertamos los datos de hermandad debajo de los datos del contacto, antes del notebook -->
            <xpath expr="//notebook" position="before">
                <group string="Datos de Hermandad" name="brother_data_group" invisible="not is_brother">
                    <group name="brother_main_info">
                        <field name="ref" string="Referencia / Nº Hermano"/>
                        <field name="brother_since" groups="base.group_user"/>
                        <field name="brother_end_date" groups="base.group_user"/>
                        <field name="brother_district" groups="base.group_user"/>
                        <field name="brother_category" groups="base.group_user" invisible="1"/>
                    </group>
                    <group name="brother_extra_info">
                        <field name="brother_has_delegated_collection" groups="base.group_user"/>
                        <field name="brother_delegated_partner_id" groups="base.group_user" invisible="not brother_has_delegated_collection"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>

    <!-- Search view propio para hermanos (se puede usar junto al dominio del menú) -->
    <record id="view_res_partner_search_rocio_hermanos" model="ir.ui.view">
        <field name="name">res.partner.search.rocio.hermanos</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="email"/>
                <filter name="filter_is_brother_active" string="Hermanos activos" domain="[('brother_active','=',True)]"/>
                <filter name="filter_brother_historic" string="Hermanos de baja" domain="[('is_brother','=',True),('brother_end_date','>','1900-01-01')]"/>
            </search>
        </field>
    </record>

    <!-- Vista de árbol específica para hermanos (solo los mostrados por menú) -->
    <record id="view_res_partner_tree_rocio_hermanos" model="ir.ui.view">
        <field name="name">res.partner.tree.rocio.hermanos</field>
        <field name="model">res.partner</field>
        <field name="priority">1</field>
        <field name="arch" type="xml">
            <list string="Hermanos">
                <field name="name"/>
                <field name="street"/>
                <field name="brother_district"/>
                <field name="brother_since"/>
                <field name="brother_end_date"/>
                <field name="zip"/>
                <field name="city"/>
                <field name="state_id"/>
                <field name="brother_birth_date"/>
                <field name="brother_method_of_payment"/>
                <field name="brother_advertising"/>
                <field name="email" optional="hide"/>
                <field name="phone" optional="hide"/>
            </list>
        </field>
    </record>
</odoo>
