<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_res_partner_form_inherit_rocio_hermanos" model="ir.ui.view">
        <field name="name">res.partner.form.rocio.hermanos</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="contacts.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="/form/sheet/notebook" position="inside">
                <page string="Hermandad" attrs="{ 'invisible': [('company_id','!=',False)] }">
                    <group>
                        <group>
                            <field name="is_brother" groups="base.group_user"/>
                            <field name="brother_since" groups="base.group_user"/>
                            <field name="brother_district" groups="base.group_user"/>
                            <field name="brother_category" groups="base.group_user"/>
                        </group>
                        <group>
                            <field name="brother_has_delegated_collection" groups="base.group_user"/>
                            <field name="brother_delegated_partner_id" groups="base.group_user"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <!-- Search view filter para hermanos -->
    <record id="view_res_partner_filter_rocio_hermanos" model="ir.ui.view">
        <field name="name">res.partner.search.rocio.hermanos</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="contacts.view_res_partner_filter"/>
        <field name="arch" type="xml">
            <xpath expr="/search" position="inside">
                <!-- Explanation: Corregir el domain del filtro para que use la sintaxis adecuada -->
                <filter name="filter_is_brother" string="Hermanos" domain="[('is_brother','=',True)]"/>
            </xpath>
        </field>
    </record>

    <!-- Vista de árbol específica para hermanos (solo los mostrados por menú) -->
    <record id="view_res_partner_tree_rocio_hermanos" model="ir.ui.view">
        <field name="name">res.partner.tree.rocio.hermanos</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <tree string="Hermanos">
                <field name="name"/>
                <field name="is_company"/>
                <field name="email"/>
                <field name="phone"/>
                <field name="brother_since"/>
                <field name="brother_category"/>
            </tree>
        </field>
    </record>
</odoo>
