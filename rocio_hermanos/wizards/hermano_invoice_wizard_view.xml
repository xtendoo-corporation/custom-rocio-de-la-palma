<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_rocio_hermano_invoice_wizard" model="ir.ui.view">
        <field name="name">rocio.hermano.invoice.wizard.form</field>
        <field name="model">rocio.hermano.invoice.wizard</field>
        <field name="arch" type="xml">
            <form string="Generar cuotas de hermanos">
                <sheet>
                    <group>
                        <field name="invoice_date"/>
                        <field name="product_id"/>
                        <field name="journal_id"/>
                        <field name="partner_domain" widget="domain" options="{'model' : 'res.partner'}"/>
                    </group>
                    <footer>
                        <button string="Generar facturas" type="object" name="action_generate_invoices" class="btn-primary"/>
                        <button string="Cancelar" class="btn-secondary" special="cancel"/>
                    </footer>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
