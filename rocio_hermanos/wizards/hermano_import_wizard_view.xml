<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Vista del wizard de importación -->
    <record id="view_rocio_hermano_import_wizard_form" model="ir.ui.view">
        <field name="name">rocio.hermano.import.wizard.form</field>
        <field name="model">rocio.hermano.import.wizard</field>
        <field name="arch" type="xml">
            <form string="Importar hermanos desde Excel">
                <group>
                    <group>
                        <field name="file" filename="filename" invisible="created_count &gt; 0"/>
                        <field name="filename" invisible="1"/>
                    </group>
                </group>

                <!-- Resultados de la importación -->
                <group invisible="created_count == 0 and updated_count == 0 and error_count == 0">
                    <group string="Resultados">
                        <field name="created_count" readonly="1"/>
                        <field name="updated_count" readonly="1"/>
                        <field name="error_count" readonly="1"/>
                    </group>
                </group>

                <notebook invisible="not log_message">
                    <page string="Log de importación">
                        <field name="log_message" readonly="1" nolabel="1"/>
                    </page>
                </notebook>

                <footer>
                    <button string="Importar" name="action_import" type="object" class="btn-primary"
                            invisible="created_count &gt; 0"/>
                    <button string="Cerrar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Acción del wizard -->
    <record id="action_rocio_hermano_import_wizard" model="ir.actions.act_window">
        <field name="name">Importar hermanos</field>
        <field name="res_model">rocio.hermano.import.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <!-- Menú para acceder al wizard -->
    <menuitem id="menu_rocio_hermano_import"
              name="Importar hermanos"
              parent="rocio_hermanos.menu_rocio_hermanos"
              action="action_rocio_hermano_import_wizard"
              sequence="100"/>

</odoo>

