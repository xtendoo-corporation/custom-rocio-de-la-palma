<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="recibo_cuota_hermano_document">
        <t t-call="web.html_container">
            <meta charset="UTF-8"/>
            <style type="text/css">
                body, .recibo-main {
                    font-family: 'DejaVu Sans', Arial, Helvetica, sans-serif;
                }
                .recibo-main {
                    background: #fff;
                    border-radius: 10px;
                    box-shadow: 0 2px 8px #bbb;
                    padding: 24px 24px 16px 24px;
                    margin: 0 auto 10px auto;
                    width: 95%;
                }
                .recibo-header {
                    background: #1a4fa0;
                    color: #fff;
                    border-radius: 8px 8px 0 0;
                    padding: 16px 8px 10px 8px;
                    text-align: center;
                    margin-bottom: 18px;
                }
                .recibo-header strong {
                    font-size: 20px;
                    letter-spacing: 1px;
                }
                .recibo-info {
                    margin-bottom: 10px;
                    font-size: 13px;
                }
                .recibo-table {
                    width: 100%;
                    border-collapse: collapse;
                    margin-bottom: 12px;
                    font-size: 13px;
                }
                .recibo-table th {
                    background: #1a4fa0;
                    color: #fff;
                    padding: 6px 4px;
                    border-bottom: 2px solid #1a4fa0;
                }
                .recibo-table td {
                    padding: 5px 4px;
                    border-bottom: 1px solid #e0e0e0;
                }
                .recibo-table tr:nth-child(even) td {
                    background: #f4f7fb;
                }
                .recibo-total {
                    text-align: right;
                    font-size: 16px;
                    color: #1a4fa0;
                    font-weight: bold;
                    margin-top: 8px;
                }
            </style>
            <t t-foreach="docs" t-as="invoice">
                <div class="recibo-main">
                    <div class="recibo-header">
                        <strong>HERMANDAD DE NTRA. SRA. DEL ROCÍO</strong><br/>
                        <span>Calle Ejemplo, 123 - 21000 Huelva</span><br/>
                        <span>CIF: X12345678</span> <span>Tel: 959 000 000</span>
                    </div>
                    <div class="recibo-info">
                        <strong>Fecha:</strong> <span t-esc="invoice.invoice_date"/>
                        |
                        <strong>Nº de Recibo:</strong> <span t-esc="invoice.name"/>
                    </div>
                    <div class="recibo-info">
                        <strong>Hermano:</strong> <span t-esc="invoice.partner_id.name"/>
                    </div>
                    <div class="recibo-info">
                        <strong>Dirección de entrega:</strong>
                        <t t-if="invoice.partner_shipping_id">
                            <span t-esc="invoice.partner_shipping_id.contact_address"/>
                        </t>
                        <t t-else="">
                            <span t-esc="invoice.partner_id.contact_address"/>
                        </t>
                    </div>
                    <table class="recibo-table">
                        <thead>
                            <tr>
                                <th>Concepto</th>
                                <th style="text-align: right;">Importe</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="invoice.invoice_line_ids" t-as="line">
                                <td><span t-esc="line.name"/></td>
                                <td style="text-align: right;"><span t-esc="line.price_subtotal"/> <span>€</span></td>
                            </tr>
                        </tbody>
                    </table>
                    <div class="recibo-total">
                        Total: <span t-esc="invoice.amount_total"/> <span>€</span>
                    </div>
                </div>
            </t>
        </t>
    </template>
</odoo>
